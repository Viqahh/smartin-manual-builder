# Smartin Manual Builder — environment contract (Phase 2)
# Copy to .env.local and fill in. NEVER commit .env.local or real credentials.
# Source of truth: docs/DEPENDENCIES.md + docs/ACCEPTANCE_CRITERIA.md (AC-P2-2).

# --- Supabase (required for the real data path) ---
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key (safe for the browser bundle)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= 
# Secret / service-role key — SERVER ONLY. Must never reach the browser bundle (GI-9 / AC-P2-3).
SUPABASE_SECRET_KEY=

# --- Application ---
# Absolute base URL of this deployment, e.g. http://localhost:3000
APP_URL=http://localhost:3000

# --- Environment identity (Phase 8A.5 — Supabase environment isolation) ---
# development | preview | production. Explicit value wins; otherwise derived from VERCEL_ENV;
# otherwise "development". DEV/Preview and Production use SEPARATE Supabase projects:
#   development + preview  -> smartin-manual-builder-dev  (ref tmrwhkhydkjaubpuegqa)
#   production             -> smartin-manual-builder-prod (ref wotidyhpbltoxmzvdqkj)
# Set APP_ENV=development in local .env.local. On Vercel set it per-environment.
APP_ENV=development

# --- Integration tests (LIVE Supabase — DEV ONLY) ---
# The integration suite WRITES. It refuses to run unless the target is provably the DEV project
# (tests/integration/_guard.ts). Never point these at Production.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
# Optional: dedicated service-role key for the test run. Falls back to SUPABASE_SECRET_KEY.
SUPABASE_TEST_SECRET_KEY=

# --- Fixture / UAT scripts (DEV ONLY) ---
# scripts/fixtures/* refuse to run without this explicit opt-in AND a DEV target.
# Set to "yes-dev" only for a deliberate destructive fixture run against DEV.
ALLOW_DESTRUCTIVE_FIXTURES=

# --- PDF export (Phase 7 slice 4) ---
# HMAC-SHA256 secret for the signed internal print route. SERVER ONLY. High entropy.
# MUST be distinct from SUPABASE_SECRET_KEY, AI_API_KEY, and the Vercel bypass secret.
# Never NEXT_PUBLIC. Never logged / serialized / rendered.
PDF_PRINT_SECRET=
# LOCAL ONLY: absolute path to a Chromium/Chrome executable for local PDF generation
# (e.g. `node -e "console.log(require('@playwright/test').chromium.executablePath())"`).
# NOT a secret. On Vercel the PDF route uses @sparticuz/chromium and ignores this.
PDF_LOCAL_CHROMIUM_PATH=
# Set by Vercel (Deployment Protection → Protection Bypass for Automation). SERVER ONLY.
# The PDF route's Chromium sends it as `x-vercel-protection-bypass` to reach a protected
# preview. Never in a URL / query string / log / PDF / client bundle.
VERCEL_AUTOMATION_BYPASS_SECRET=

# --- AI (Phase 4 — grounded writing assistant) ---
# Leave BOTH empty to use the deterministic Mock AI provider (the default; UI shows "Mock AI").
# Set BOTH to use a real provider. Setting exactly one is a hard server config error (no silent
# fallback). The only adapter shipped in Phase 4 is AI_PROVIDER=anthropic.
# AI_API_KEY is SERVER ONLY — it is never sent to the browser bundle, a provider payload, logs,
# ai_revisions, or an error message.
AI_PROVIDER=
AI_API_KEY=
# Optional model override for the configured provider (defaults to a current small model).
AI_MODEL=

# When NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY
# are all absent the app still boots: /api/health reports ok:true, ready:false and the
# workspace shows a "Supabase belum dikonfigurasi" state instead of crashing.
