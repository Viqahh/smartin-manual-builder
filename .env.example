# Smartin Manual Builder — environment contract (Phase 2)
# Copy to .env.local and fill in. NEVER commit .env.local or real credentials.
# Source of truth: docs/DEPENDENCIES.md + docs/ACCEPTANCE_CRITERIA.md (AC-P2-2).

# --- Supabase (required for the real data path) ---
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key (safe for the browser bundle)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret / service-role key — SERVER ONLY. Must never reach the browser bundle (GI-9 / AC-P2-3).
SUPABASE_SECRET_KEY=

# --- Application ---
# Absolute base URL of this deployment, e.g. http://localhost:3000
APP_URL=http://localhost:3000

# --- AI (Phase 4 — not used in Phase 2; listed for the full contract) ---
AI_PROVIDER=
AI_API_KEY=

# When NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY
# are all absent the app still boots: /api/health reports ok:true, ready:false and the
# workspace shows a "Supabase belum dikonfigurasi" state instead of crashing.
